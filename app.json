{
  "expo": {
    "name": "kaskad-mobile",
    "slug": "kaskad-mobile",
    "scheme": "kaskad-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/kaskad.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/kaskad.png",
        "backgroundImage": "./assets/icons/kaskad.png",
        "monochromeImage": "./assets/icons/kaskad.png"
      }
    },
    "web": {
      "favicon": "./assets/icons/kaskad.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}