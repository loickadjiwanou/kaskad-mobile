{
  "expo": {
    "name": "Kaskad",
    "slug": "kaskad-mobile",
    "scheme": "kaskad",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icons/kaskad.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icons/kaskad_transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaskad.store",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown"
        ]
      },
      "requireFullScreen": true
    },
    "android": {
      "package": "com.kaskad.store",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/icons/kaskad_transparent.png",
        "monochromeImage": "./assets/icons/kaskad_transparent.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icons/kaskad.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/kaskad_transparent.png",
          "color": "#2F6BFF"
        }
      ],
      "expo-localization",
      "expo-font"
    ]
  }
}
